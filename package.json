{
  "name": "study-kit",
  "version": "0.1.0",
  "description": "Subject-agnostic study engine: grounded tutor, study lab, answer marking, spaced review, progress maths and deadline export for any curriculum.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "education",
    "study",
    "tutor",
    "flashcards",
    "spaced-repetition",
    "quiz",
    "curriculum",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akira-Val-297/study-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Akira-Val-297/study-kit/issues"
  },
  "homepage": "https://github.com/Akira-Val-297/study-kit#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "node examples/algebra.ts",
    "prepublishOnly": "npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
